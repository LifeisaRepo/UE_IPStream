# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
!Plugins/**/ThirdParty/**/*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib
!Plugins/**/ThirdParty/**/*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Diagnostic captures (ffprobe/ffplay/etc.) - may contain credentials
# embedded in stream URLs. Never commit; summarize findings into Docs/ instead.
# Placed here, before the Build/ whitelist below, so the later
# !Build/*/PakBlacklist*.txt negation still wins for that one file —
# .gitignore uses last-match-wins, so a broad *.txt appearing after that
# negation would silently re-ignore it once Build/ actually exists (M5).
*.txt

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
